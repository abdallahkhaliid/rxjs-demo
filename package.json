{
  "name": "rxjs-demo",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node server/dist/server.js",
    "start:dev": "ng serve",
    "build": "ng build",
    "build:gh-pages": "ng build --base-href ./",
    "build:server": "tsc -p server/server.tsconfig.json",
    "build:all": "ng build && tsc -p server/server.tsconfig.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "ts-node -P server/server.tsconfig.json server/server.ts",
    "server:prod": "node server/dist/server.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "highlight.js": "^11.12.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.4",
    "@angular/cli": "^20.3.4",
    "@angular/compiler-cli": "^20.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.6.6",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  }
}
